---
const PHONE = import.meta.env.PUBLIC_PHONE || '+237 6 99 77 48 82';
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/services', label: 'Nos services' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">

    <a href="/" class="flex items-center gap-1.5">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="14" cy="14" r="14" fill="#1A6B4A"/>
        <path d="M14 7v14M7 14h14" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="text-xl font-extrabold" style="color:#1A6B4A">SoinsMboa</span>
      <span class="hidden sm:block text-xs text-gray-400 font-medium mt-0.5">Cameroun</span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {links.map(l => (
        <a href={l.href} class="text-gray-600 hover:text-[#1A6B4A] font-semibold text-sm transition-colors">
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href={`tel:${PHONE}`}
      class="hidden md:flex items-center gap-2 text-white text-sm font-bold px-4 py-2 rounded-full transition-opacity hover:opacity-90"
      style="background:#1A6B4A"
    >
      <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      {PHONE}
    </a>

    <!-- Mobile menu button -->
    <button id="menu-btn" class="md:hidden p-2 text-gray-600" aria-label="Menu">
      <svg id="icon-open" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="icon-close" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="hidden">
        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-4 py-4 flex flex-col gap-3">
    {links.map(l => (
      <a href={l.href} class="text-gray-700 font-semibold py-2 border-b border-gray-50">
        {l.label}
      </a>
    ))}
    <a
      href={`tel:${PHONE}`}
      class="flex items-center justify-center gap-2 text-white font-bold px-4 py-3 rounded-full mt-2"
      style="background:#1A6B4A"
    >
      Appeler maintenant
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });
</script>
