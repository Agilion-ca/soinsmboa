---
const PHONE = import.meta.env.PUBLIC_PHONE || '+237 6 99 77 48 82';
const PHONE_2 = import.meta.env.PUBLIC_PHONE_2 || '+237 6 76 81 47 85';
const WHATSAPP = import.meta.env.PUBLIC_WHATSAPP || '237699774882';
const WHATSAPP_2 = import.meta.env.PUBLIC_WHATSAPP_2 || '237676814785';
---

<footer style="background:#1A6B4A" class="text-white mt-0">
  <div class="max-w-6xl mx-auto px-4 py-14 grid grid-cols-1 md:grid-cols-4 gap-8">

    <div class="md:col-span-2">
      <div class="mb-3">
        <img src="/logo-mark.svg" alt="SoinsMboa" width="44" height="50" style="height:50px;width:auto;filter:brightness(0) invert(1)" loading="lazy"/>
        <span class="sr-only">SoinsMboa</span>
      </div>
      <p class="text-green-100 text-sm leading-relaxed max-w-sm">
        Service professionnel de soins à domicile et en milieu hospitalier à Douala et Yaoundé.
        Disponible 7j/7 pour vous et vos proches.
      </p>
      <div class="mt-4 space-y-2">
        <a href={`tel:${PHONE}`}
           class="flex items-center gap-2 text-green-100 hover:text-white text-sm font-semibold transition">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
          {PHONE}
        </a>
        <a href={`tel:${PHONE_2}`}
           class="flex items-center gap-2 text-green-100 hover:text-white text-sm font-semibold transition">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
          {PHONE_2}
        </a>
      </div>
      <div class="flex gap-3 mt-4">
        <a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 bg-[#25D366] hover:opacity-90 text-white text-sm font-semibold px-4 py-2 rounded-full transition">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>

    <div>
      <h4 class="font-bold text-sm uppercase tracking-wider text-green-300 mb-4">Navigation</h4>
      <ul class="space-y-2">
        {[['Accueil', '/'], ['Nos services', '/services'], ['Blog santé', '/blog'], ['Contact', '/contact']].map(([label, href]) => (
          <li>
            <a href={href} class="text-green-100 hover:text-white text-sm transition-colors">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-sm uppercase tracking-wider text-green-300 mb-4">Services</h4>
      <ul class="space-y-2">
        {['Auxiliaire de vie', 'Garde-malade', 'Médecin à domicile'].map(s => (
          <li>
            <a href="/services" class="text-green-100 hover:text-white text-sm transition-colors">{s}</a>
          </li>
        ))}
      </ul>
      <div class="mt-5">
        <p class="text-green-300 text-xs font-semibold uppercase tracking-wider mb-1">Zones</p>
        <p class="text-green-100 text-sm">Douala &amp; Yaoundé</p>
        <p class="text-green-300 text-xs mt-1">Cameroun</p>
      </div>
    </div>
  </div>

  <div class="border-t border-green-700 py-4 text-center text-green-400 text-xs">
    © {new Date().getFullYear()} SoinsMboa. Tous droits réservés. &nbsp;·&nbsp;
    <a href="/confidentialite" class="hover:text-white transition-colors">Confidentialité</a>
    &nbsp;·&nbsp;
    <a href="/mentions-legales" class="hover:text-white transition-colors">Mentions légales</a>
  </div>
</footer>
