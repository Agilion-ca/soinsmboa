---
const PHONE = import.meta.env.PUBLIC_PHONE || '+237 6 99 77 48 82';
const WHATSAPP = import.meta.env.PUBLIC_WHATSAPP || '237699774882';
const msg = encodeURIComponent("Bonjour, j'ai besoin d'un soignant pour un proche au Cameroun.");

const stats = [
  { val: '+500',   fr: "Familles\naccompagnées",        en: "Families\nsupported" },
  { val: '24h/24', fr: "Disponibilité\n7j/7",           en: "Availability\n7 days/7" },
  { val: '<24h',   fr: "Délai d'intervention\nmoyen",   en: "Average response\ntime" },
  { val: '2 villes', fr: "Douala &\nYaoundé",           en: "Douala &\nYaoundé" },
];
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/images/hero.jpg"
      alt="Soignante professionnelle au Cameroun"
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(10,40,25,0.88) 0%, rgba(10,40,25,0.60) 55%, rgba(10,40,25,0.30) 100%)"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 py-20 grid md:grid-cols-2 gap-10 items-center w-full">
    <div class="text-white">
      <span class="inline-flex items-center gap-2 bg-white/20 backdrop-blur text-white text-xs font-bold px-3 py-1.5 rounded-full mb-5 uppercase tracking-wider">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <circle cx="5" cy="5" r="4" fill="#4ade80"/>
        </svg>
        <span class="i18n" data-fr="Disponible maintenant · Douala &amp; Yaoundé" data-en="Available now · Douala &amp; Yaoundé">Disponible maintenant · Douala &amp; Yaoundé</span>
      </span>

      <h1 class="text-4xl md:text-5xl xl:text-6xl font-extrabold leading-tight mb-5">
        <span class="i18n" data-fr="Votre parent est malade" data-en="Is your loved one sick">Votre parent est malade</span><br />
        <span style="color:#86efac" class="i18n" data-fr="au Cameroun ?" data-en="in Cameroon?">au Cameroun ?</span><br />
        <span class="text-3xl md:text-4xl font-bold text-white/90 i18n" data-fr="Nous veillons sur lui." data-en="We are here for them.">
          Nous veillons sur lui.
        </span>
      </h1>

      <p class="text-white/85 text-lg leading-relaxed mb-8 max-w-lg i18n"
        data-fr="Auxiliaires de vie, gardes-malades et médecins à domicile à Douala et Yaoundé. Intervention en moins de 24h. Compte-rendu quotidien à votre famille à l'étranger."
        data-en="Home helpers, caregivers and doctors in Douala and Yaoundé. Response in under 24h. Daily updates for your family abroad.">
        Auxiliaires de vie, gardes-malades et médecins à domicile à Douala et Yaoundé. Intervention en moins de 24h. Compte-rendu quotidien à votre famille à l'étranger.
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={`tel:${PHONE}`}
          class="flex items-center justify-center gap-2 text-white font-bold px-7 py-4 rounded-full text-base transition hover:opacity-90 hover:scale-105"
          style="background:#FF6B35"
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          <span class="i18n" data-fr="Appeler maintenant" data-en="Call now">Appeler maintenant</span>
        </a>
        <a
          href={`https://wa.me/${WHATSAPP}?text=${msg}`}
          target="_blank" rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-white/15 border border-white/40 text-white font-semibold px-7 py-4 rounded-full text-base hover:bg-white/25 transition"
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span class="i18n" data-fr="Message WhatsApp" data-en="WhatsApp message">Message WhatsApp</span>
        </a>
      </div>

      <p class="mt-4 text-white/60 text-sm flex items-center gap-2">
        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" class="shrink-0"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Douala &amp; Yaoundé · {PHONE}
      </p>
    </div>

    <div class="hidden md:grid grid-cols-2 gap-4">
      {stats.map(({ val, fr, en }) => (
        <div class="bg-white/15 backdrop-blur rounded-2xl p-5 text-white text-center border border-white/20">
          <p class="text-3xl font-extrabold mb-1">{val}</p>
          <p class="text-white/75 text-xs whitespace-pre-line leading-relaxed i18n" data-fr={fr} data-en={en}>{fr}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden md:block">
    <div class="w-6 h-10 border-2 border-white/40 rounded-full flex items-start justify-center pt-2">
      <div class="w-1.5 h-3 bg-white/60 rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
