---
const steps = [
  {
    n: '01',
    emoji: '📞',
    title: 'Vous nous contactez',
    desc: "Appelez, envoyez un WhatsApp ou remplissez notre formulaire. Vous êtes à Paris, Bruxelles ou Montréal — peu importe. Nous répondons dans l'heure.",
  },
  {
    n: '02',
    emoji: '📋',
    title: 'Évaluation gratuite',
    desc: "Un coordinateur vous rappelle pour évaluer les besoins de votre proche : état de santé, disponibilités, lieu d'intervention. Gratuit, sans engagement.",
  },
  {
    n: '03',
    emoji: '🤝',
    title: 'Prise en charge rapide',
    desc: "Le soignant intervient en moins de 24h. Vous recevez un compte-rendu quotidien. Votre proche est en de bonnes mains.",
  },
];
---

<section id="comment" class="py-20" style="background:#F0FAF5">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-14">
      <span class="text-sm font-bold uppercase tracking-wider" style="color:#1A6B4A">Simple & rapide</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mt-2 text-gray-900">
        Comment ça marche depuis l'étranger ?
      </h2>
      <p class="text-gray-500 mt-3 max-w-lg mx-auto">
        Vous êtes loin, mais vous restez aux commandes. Tout se fait par téléphone et WhatsApp.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 relative">
      <!-- Ligne de connexion desktop -->
      <div class="hidden md:block absolute top-10 left-[20%] right-[20%] h-0.5 bg-green-200 z-0"></div>

      {steps.map(({ n, emoji, title, desc }) => (
        <div class="relative bg-white rounded-2xl p-6 shadow-sm border border-green-100 text-center z-10">
          <div class="relative inline-block mb-4">
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-3xl border-4 border-[#F0FAF5] shadow-md" style="background:#1A6B4A">
              {emoji}
            </div>
            <span class="absolute -top-1 -right-1 w-7 h-7 rounded-full text-xs font-extrabold flex items-center justify-center text-white" style="background:#FF6B35">
              {n}
            </span>
          </div>
          <h3 class="text-lg font-extrabold text-gray-900 mb-2">{title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/contact" class="inline-flex items-center gap-2 text-white font-bold px-8 py-4 rounded-full transition hover:opacity-90" style="background:#1A6B4A">
        Demander une évaluation gratuite
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
