---
const faqs = [
  {
    q: { fr: "Combien coûte une garde-malade à Douala ou Yaoundé ?",
         en: "How much does a caregiver cost in Douala or Yaoundé?" },
    a: { fr: "Les tarifs varient selon la durée, le type de soin et les horaires (jour/nuit). Nous proposons un devis gratuit et personnalisé après une évaluation téléphonique. Aucune surprise : tout est fixé à l'avance.",
         en: "Prices vary by duration, type of care and hours (day/night). We offer a free personalised quote after a phone assessment. No surprises: everything is agreed in advance." },
  },
  {
    q: { fr: "Comment organiser les soins de mes parents au Cameroun depuis la France ?",
         en: "How can I organise care for my parents in Cameroon from abroad?" },
    a: { fr: "Tout se fait à distance. Un appel ou un message WhatsApp suffit pour lancer l'évaluation. Ensuite vous recevez un compte-rendu quotidien et pouvez joindre votre coordinateur à tout moment. Beaucoup de nos clients sont à Paris, Lyon, Bruxelles ou Montréal.",
         en: "Everything is done remotely. A call or WhatsApp message is all it takes. You then receive a daily update and can reach your coordinator anytime. Many of our clients are in Paris, Lyon, Brussels or Montreal." },
  },
  {
    q: { fr: "Vos soignants peuvent-ils intervenir à l'hôpital ou en clinique ?",
         en: "Can your caregivers work in a hospital or clinic?" },
    a: { fr: "Oui, absolument. Nos gardes-malades interviennent aussi bien à domicile qu'en structure hospitalière (hôpital général, cliniques privées de Douala et Yaoundé). Ils travaillent en coordination avec le personnel soignant.",
         en: "Yes, absolutely. Our caregivers work both at home and in hospitals (public hospitals, private clinics in Douala and Yaoundé). They coordinate with the medical team." },
  },
  {
    q: { fr: "Quelle est la différence entre une auxiliaire de vie et une garde-malade ?",
         en: "What is the difference between a home helper and a caregiver?" },
    a: { fr: "L'auxiliaire de vie accompagne les personnes en perte d'autonomie dans les gestes du quotidien (toilette, repas, sorties). La garde-malade assure une surveillance médicale et une présence continue, notamment pour des personnes malades ou post-opératoires.",
         en: "A home helper assists people losing independence with daily tasks (hygiene, meals, outings). A caregiver provides medical monitoring and continuous presence, especially for ill or post-surgery patients." },
  },
  {
    q: { fr: "Intervenez-vous la nuit et le week-end ?",
         en: "Do you work nights and weekends?" },
    a: { fr: "Oui. Notre service est disponible 7j/7, y compris les nuits, week-ends et jours fériés. Des suppléments peuvent s'appliquer pour les plages horaires nocturnes.",
         en: "Yes. Our service is available 7 days a week, including nights, weekends and public holidays. Supplements may apply for night hours." },
  },
  {
    q: { fr: "Comment se passe le paiement depuis l'étranger ?",
         en: "How does payment work from abroad?" },
    a: { fr: "Nous acceptons les virements bancaires internationaux, ainsi que les Mobile Money (Orange Money, MTN MoMo) pour faciliter les paiements depuis le Cameroun. Devis et facturation transparents.",
         en: "We accept international bank transfers and Mobile Money (Orange Money, MTN MoMo). Transparent quotes and invoicing." },
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q.fr,
    "acceptedAnswer": { "@type": "Answer", "text": a.fr },
  })),
};
---

<section id="faq" class="py-20" style="background:#F0FAF5">
  <div class="max-w-3xl mx-auto px-4">
    <div class="text-center mb-12">
      <span class="text-sm font-bold uppercase tracking-wider i18n" style="color:#1A6B4A" data-fr="Questions fréquentes" data-en="Frequently asked questions">Questions fréquentes</span>
      <h2 class="text-3xl md:text-4xl font-extrabold mt-2 text-gray-900 i18n"
        data-fr="Tout ce que vous devez savoir"
        data-en="Everything you need to know">
        Tout ce que vous devez savoir
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map(({ q, a }) => (
        <details class="group bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-800 hover:text-[#1A6B4A] list-none gap-3">
            <span class="i18n" data-fr={q.fr} data-en={q.en}>{q.fr}</span>
            <svg class="shrink-0 w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed border-t border-gray-100 pt-3">
            <span class="i18n" data-fr={a.fr} data-en={a.en}>{a.fr}</span>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
