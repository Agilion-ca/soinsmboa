---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const PHONE = import.meta.env.PUBLIC_PHONE || '+237 6XX XXX XXX';
const WHATSAPP = import.meta.env.PUBLIC_WHATSAPP || '237600000000';

const services = [
  {
    id: 'auxiliaire',
    title: 'Auxiliaire de vie',
    tagline: 'Aide quotidienne et accompagnement',
    desc: `L'auxiliaire de vie accompagne au quotidien les personnes âgées, handicapées ou en convalescence. Elle intervient à domicile pour faciliter les gestes essentiels et offrir une présence bienveillante, indispensable pour les familles vivant à l'étranger.`,
    prestations: [
      'Aide à la toilette et à l\'habillage',
      'Préparation et aide aux repas',
      'Entretien courant du logement',
      'Courses et gestion du quotidien',
      'Accompagnement aux rendez-vous médicaux',
      'Stimulation cognitive et activités',
      'Soutien moral et compagnie',
    ],
    forWho: ['Personnes âgées dépendantes', 'Personnes handicapées', 'Convalescents post-opératoires', 'Familles vivant à l\'étranger'],
    img: '/images/service-auxiliaire.jpg',
    imgAlt: "Mains d'une soignante et d'une personne âgée — geste de réconfort",
    credit: 'Nappy / Unsplash',
    color: '#1A6B4A',
    bg: '#F0FAF5',
  },
  {
    id: 'garde',
    title: 'Garde-malade',
    tagline: 'Surveillance et soins de confort, 24h/24',
    desc: `Le garde-malade assure une présence et une surveillance continue auprès du patient, à domicile ou en milieu hospitalier. Il travaille en coordination avec le personnel médical et tient la famille informée chaque jour — essentiel quand vous êtes à des milliers de kilomètres.`,
    prestations: [
      'Surveillance continue de l\'état du patient',
      'Soins de confort et prévention des escarres',
      'Administration des médicaments selon prescription',
      'Présence à l\'hôpital ou en clinique',
      'Compte-rendu quotidien à la famille',
      'Coordination avec l\'équipe soignante',
      'Gestion des urgences de nuit',
    ],
    forWho: ['Patients hospitalisés', 'Post-opératoires', 'Patients en soins intensifs', 'Personnes seules sans famille proche'],
    img: '/images/service-garde.jpg',
    imgAlt: 'Infirmière en blouse bleue avec stéthoscope — soin en milieu hospitalier',
    credit: 'CDC / Unsplash',
    color: '#FF6B35',
    bg: '#FFF5F0',
  },
  {
    id: 'medecin',
    title: 'Médecin à domicile',
    tagline: 'Consultation médicale sans déplacement',
    desc: `Nos médecins généralistes et spécialistes se déplacent à domicile ou en clinique. Idéal pour éviter les longues attentes, pour les personnes à mobilité réduite, ou pour un suivi rapide quand vous ne pouvez pas être présent.`,
    prestations: [
      'Consultation générale complète',
      'Diagnostic et prescription d\'ordonnance',
      'Suivi des maladies chroniques',
      'Suivi post-opératoire',
      'Certificats médicaux',
      'Urgences légères (fièvre, chute, douleur)',
      'Coordination avec spécialistes',
    ],
    forWho: ['Personnes à mobilité réduite', 'Patients fragiles', 'Urgences légères', 'Suivi chronique'],
    img: '/images/service-medecin.jpg',
    imgAlt: 'Médecin africaine en blouse blanche avec stéthoscope rouge, souriant',
    credit: 'Ato Aikins / Unsplash',
    color: '#1A6B4A',
    bg: '#F0FAF5',
  },
];

const faqs = [
  { q: "Quels sont vos délais d'intervention ?", a: "Auxiliaires de vie et gardes-malades : 24 à 48h. Médecins à domicile : le jour même dans la majorité des cas." },
  { q: "Comment se passe le suivi pour les familles à l'étranger ?", a: "Vous recevez un compte-rendu quotidien par WhatsApp ou email. Votre coordinateur est joignable à tout moment." },
  { q: "Les soignants sont-ils qualifiés ?", a: "Oui. Diplômes vérifiés, expérience minimum requise, entretien et références. Formation continue assurée." },
  { q: "Intervenez-vous de nuit et le week-end ?", a: "Oui, service 7j/7 et 24h/24. Suppléments possibles pour les horaires nocturnes." },
  { q: "Quels modes de paiement acceptez-vous ?", a: "Virement bancaire international, Orange Money, MTN MoMo. Devis et facturation transparents." },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(({ q, a }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a },
  })),
};
---

<Layout
  title="Nos services de soins à domicile | SoinsMboa"
  description="Auxiliaires de vie, gardes-malades et médecins à domicile à Douala et Yaoundé. Détail des prestations, tarifs sur devis, disponibilité 24h/24."
  schema={schema}
>
  <!-- Hero -->
  <section class="py-16 text-white" style="background:linear-gradient(135deg,#1A6B4A 0%,#0f4a33 100%)">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Nos services</h1>
      <p class="text-green-100 text-lg max-w-xl mx-auto">
        Des prestations professionnelles pour vos proches à Douala et Yaoundé,
        organisées depuis n'importe où dans le monde.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="max-w-5xl mx-auto px-4 py-16 space-y-24">
    {services.map(({ id, title, tagline, desc, prestations, forWho, img, imgAlt, credit, color, bg }, i) => (
      <div id={id} class="scroll-mt-20">
        <div class={`grid md:grid-cols-2 gap-10 items-center ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>

          <!-- Photo -->
          <div class="relative rounded-2xl overflow-hidden shadow-md aspect-[4/3]">
            <img
              src={img}
              alt={imgAlt}
              class="w-full h-full object-cover"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-0" style={`background:linear-gradient(to top, ${color}99 0%, transparent 55%)`}></div>
            <div class="absolute bottom-4 left-4 right-4">
              <h2 class="text-2xl font-extrabold text-white">{title}</h2>
              <p class="text-white/80 text-sm font-medium">{tagline}</p>
            </div>
            <p class="absolute top-3 right-3 text-white/40 text-[10px]">{credit}</p>
          </div>

          <!-- Contenu -->
          <div>
            <p class="text-gray-600 leading-relaxed mb-5">{desc}</p>

            <div class="mb-5">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-2">Pour qui ?</p>
              <div class="flex flex-wrap gap-2">
                {forWho.map(w => (
                  <span class="text-xs font-semibold px-3 py-1 rounded-full" style={`background:${bg};color:${color}`}>{w}</span>
                ))}
              </div>
            </div>

            <div class="rounded-2xl p-5" style={`background:${bg}`}>
              <p class="font-bold text-gray-900 mb-3 text-sm">Ce qui est inclus</p>
              <ul class="space-y-2">
                {prestations.map(p => (
                  <li class="flex items-start gap-2 text-sm text-gray-700">
                    <span class="w-5 h-5 rounded-full flex items-center justify-center text-white text-xs shrink-0 mt-0.5" style={`background:${color}`}>✓</span>
                    {p}
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-xs text-gray-400">Tarif sur devis · Évaluation gratuite</p>
            </div>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- FAQ -->
  <section class="py-14" style="background:#F0FAF5">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-8 text-center">Questions fréquentes</h2>
      <div class="space-y-3">
        {faqs.map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-gray-100 overflow-hidden">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-800 list-none gap-3 hover:text-[#1A6B4A]">
              {q}
              <svg class="shrink-0 w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <div class="px-5 pb-4 pt-2 text-sm text-gray-600 border-t border-gray-100">{a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 text-white" style="background:linear-gradient(135deg,#1A6B4A 0%,#0f4a33 100%)">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-extrabold mb-3">Prêt à commencer ?</h2>
      <p class="text-green-100 mb-6">Évaluation gratuite par téléphone. Intervention sous 24h.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`tel:${PHONE}`} class="flex items-center justify-center gap-2 font-bold px-6 py-3 rounded-full text-white" style="background:#FF6B35">{PHONE}</a>
        <a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 font-semibold px-6 py-3 rounded-full bg-white/15 border border-white/30 text-white hover:bg-white/25 transition">WhatsApp</a>
        <a href="/contact" class="flex items-center justify-center gap-2 font-semibold px-6 py-3 rounded-full border border-white/30 text-white hover:bg-white/10 transition">Formulaire</a>
      </div>
    </div>
  </section>
</Layout>
