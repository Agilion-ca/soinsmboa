---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleRenderer from '../../components/blog/ArticleRenderer.astro';

export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ id }) => id !== '_index');
  return articles.map((entry) => ({
    params: { slug: entry.data.meta.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const article = entry.data;
const siteUrl = 'https://gardemalade-cm.com';

// Use FR as canonical, EN via toggle
const canonicalUrl = `${siteUrl}/blog/${article.meta.slug}`;
const ogImage = article.hero.src ? `${siteUrl}${article.hero.src}` : '/images/hero.jpg';

// Build related articles list
let relatedArticles: Array<{ slug: string; title_fr: string; title_en: string; category: string; hero_src: string; chapeau_fr: string }> = [];
if (article.related.length > 0) {
  const allArticles = await getCollection('blog', ({ id }) => id !== '_index');
  relatedArticles = article.related
    .map((slug) => {
      const found = allArticles.find((a) => a.data.meta.slug === slug);
      if (!found) return null;
      return {
        slug: found.data.meta.slug,
        title_fr: found.data.meta.title.fr,
        title_en: found.data.meta.title.en,
        category: found.data.meta.category,
        hero_src: found.data.hero.src,
        chapeau_fr: found.data.content.chapeau.fr,
      };
    })
    .filter(Boolean) as typeof relatedArticles;
}

// All articles for "related" fallback (same category, different slug)
const fallbackRelated = relatedArticles.length === 0
  ? (await getCollection('blog', ({ id }) => id !== '_index'))
      .filter((a) => a.data.meta.category === article.meta.category && a.data.meta.slug !== article.meta.slug)
      .slice(0, 3)
      .map((a) => ({
        slug: a.data.meta.slug,
        title_fr: a.data.meta.title.fr,
        title_en: a.data.meta.title.en,
        category: a.data.meta.category,
        hero_src: a.data.hero.src,
        chapeau_fr: a.data.content.chapeau.fr,
      }))
  : relatedArticles;
---

<Layout
  title={article.meta.title.fr}
  description={article.meta.description.fr}
  canonical={canonicalUrl}
  ogImage={ogImage}
>
  <div class="min-h-screen bg-white">
    <!-- Breadcrumb -->
    <nav class="max-w-3xl mx-auto px-4 pt-6 pb-2" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-1.5 text-sm text-gray-400 flex-wrap">
        <li><a href="/" class="hover:text-green-700 transition-colors">Accueil</a></li>
        <li aria-hidden="true"><span>/</span></li>
        <li><a href="/blog" class="hover:text-green-700 transition-colors">Blog</a></li>
        <li aria-hidden="true"><span>/</span></li>
        <li class="text-gray-600 font-medium truncate max-w-xs">{article.meta.title.fr}</li>
      </ol>
    </nav>

    <!-- Main article -->
    <ArticleRenderer article={article} siteUrl={siteUrl} />

    <!-- Related articles -->
    {fallbackRelated.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 pb-16 mt-4">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 related-heading">
          <span class="i18n-related" data-fr="Articles connexes" data-en="Related articles">Articles connexes</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {fallbackRelated.map((rel) => (
            <a
              href={`/blog/${rel.slug}`}
              class="group block rounded-2xl border border-gray-200 overflow-hidden hover:border-green-400 hover:shadow-md transition-all"
            >
              {rel.hero_src && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={rel.hero_src}
                    alt={rel.title_fr}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-4">
                <h3 class="font-bold text-gray-900 mb-2 group-hover:text-green-700 transition-colors leading-snug">
                  {rel.title_fr}
                </h3>
                <p class="text-sm text-gray-500 line-clamp-2">{rel.chapeau_fr}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // Sync related section heading with language toggle from ArticleRenderer
  (function () {
    const heading = document.querySelector('.i18n-related');
    if (!heading) return;

    function syncRelatedLang() {
      const root = document.getElementById('article-root');
      const lang = (root?.dataset.lang ?? 'fr') as 'fr' | 'en';
      const val = (heading as HTMLElement).dataset[lang];
      if (val) heading.textContent = val;
    }

    // Poll for language change (simple approach compatible with SSR)
    const observer = new MutationObserver(syncRelatedLang);
    const root = document.getElementById('article-root');
    if (root) observer.observe(root, { attributes: true, attributeFilter: ['data-lang'] });
    syncRelatedLang();
  })();
</script>
