---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Blog Santé Cameroun | GardeMalade Cameroun"
  description="Conseils santé, guides sur les soins à domicile au Cameroun, et ressources pour les familles de la diaspora. Articles publiés régulièrement."
>
  <section class="py-16 text-white" style="background:linear-gradient(135deg,#1A6B4A 0%,#0f4a33 100%)">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Blog Santé</h1>
      <p class="text-green-100 text-lg">
        Conseils, guides et ressources pour prendre soin de vos proches au Cameroun
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16 text-center">
    <div class="bg-[#F0FAF5] rounded-2xl p-12">
      <div class="text-5xl mb-4">📝</div>
      <h2 class="text-2xl font-extrabold text-gray-900 mb-3">Articles bientôt disponibles</h2>
      <p class="text-gray-600 max-w-md mx-auto mb-6">
        Notre blog avec des guides pratiques sur les soins à domicile au Cameroun arrive très bientôt.
        Des articles utiles pour les familles de la diaspora.
      </p>
      <p class="text-sm text-gray-400">Sujets prévus :</p>
      <div class="flex flex-wrap gap-2 justify-center mt-3">
        {[
          'Coût garde-malade Douala',
          'Organiser soins depuis l\'étranger',
          'Auxiliaire de vie vs garde-malade',
          'Signes d\'alerte personne âgée',
          'Soins post-opératoires Cameroun',
        ].map(t => (
          <span class="text-xs font-medium px-3 py-1.5 rounded-full" style="background:white;color:#1A6B4A;border:1px solid #d1fae5">{t}</span>
        ))}
      </div>
      <a href="/contact" class="inline-flex items-center gap-2 mt-8 text-white font-bold px-6 py-3 rounded-full" style="background:#1A6B4A">
        Nous contacter en attendant
      </a>
    </div>
  </section>
</Layout>
