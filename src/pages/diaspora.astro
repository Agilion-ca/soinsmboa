        <span class="i18n" data-fr="Écrire sur WhatsApp" data-en="Write on WhatsApp">Écrire sur WhatsApp</span>
      </a>

      <div class="flex items-center justify-center gap-6">
        <a href={`tel:${PHONE}`} class="text-sm font-semibold" style="color:rgba(255,255,255,.55)">{PHONE}</a>
        <span style="color:rgba(255,255,255,.2)">·</span>
        <a href={`tel:${PHONE_2}`} class="text-sm font-semibold" style="color:rgba(255,255,255,.55)">{PHONE_2}</a>
      </div>
      <p class="text-xs mt-3" style="color:rgba(255,255,255,.28)">
        <span class="i18n" data-fr="Douala · Yaoundé · Évaluation gratuite sans engagement" data-en="Douala · Yaoundé · Free assessment, no commitment">
          Douala · Yaoundé · Évaluation gratuite sans engagement
        </span>
      </p>
    </div>
  </section>

</Layout>
