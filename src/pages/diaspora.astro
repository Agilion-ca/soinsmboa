    <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(13,35,24,.5),rgba(13,35,24,.95))"></div>

    <div class="relative max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-4" style="letter-spacing:-1px">
        <span class="i18n"
          data-fr="Prenez soin de votre proche dès aujourd'hui."
          data-en="Take care of your loved one starting today.">
          Prenez soin de votre proche dès aujourd'hui.
